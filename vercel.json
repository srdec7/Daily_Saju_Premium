{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/privacy",
      "destination": "/api/privacy"
    },
    {
      "source": "/privacy.html",
      "destination": "/api/privacy"
    },
    {
      "source": "/shift-privacy",
      "destination": "/api/shift-privacy"
    },
    {
      "source": "/shift-privacy.html",
      "destination": "/api/shift-privacy"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
